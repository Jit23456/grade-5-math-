{
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.terminal.activateEnvironment": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "files.associations": {
    "*.html": "jinja-html"
  },
  "emmet.includeLanguages": { "jinja-html": "html" },
  "[python]": { "editor.rulers": [100] },
  "[html]": { "editor.tabSize": 2 },
  "[css]": { "editor.tabSize": 2 }
}
