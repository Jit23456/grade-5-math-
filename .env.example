# Copy to .env and fill in. Never commit the real .env file.

# Signs session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
MATH5_SECRET_KEY=

# Password for the first 'teacher' account. Only read on the very first run.
MATH5_ADMIN_PASSWORD=

# Where the database file lives. On a host with a mounted disk, point this at it,
# e.g. /var/data/math5.sqlite3
# MATH5_DB=

# Switches the AI assistant on. Leave blank and the assistant says it is off.
# Free keys from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Texts the sign-up code to a teacher's mobile. Leave these blank and sign-up
# still works, but the code is written to the server log instead of being sent.
# From your Twilio console; the number must be one Twilio has given you.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
